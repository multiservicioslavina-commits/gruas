# ── Base de datos ─────────────────────────────────────────────────────────
# PostgreSQL 14 o superior.
DATABASE_URL=postgres://usuario:clave@localhost:5432/taller_motos

# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL pública desde la que el cliente abre los enlaces de cotización.
PUBLIC_URL=http://localhost:3000

# ── Seguridad ─────────────────────────────────────────────────────────────
# OBLIGATORIO cambiarlo en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Pon ALLOW_SIGNUP=false si la instalación es de un solo taller y no quieres
# que cualquiera pueda registrar uno nuevo desde la pantalla de acceso.
ALLOW_SIGNUP=true

# ── Archivos ──────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads
UPLOADS_MAX_BYTES=8388608

# ── CORS ──────────────────────────────────────────────────────────────────
# Sólo si el frontend se sirve desde otro dominio. Separa con comas.
# CORS_ORIGINS=https://app.mitaller.com
