<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>RIDERA</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ridera_ride_live</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- ═══════════════════════════════════════════════════════════ -->
	<!-- BLUETOOTH LE — permisos y background modes                 -->
	<!-- ═══════════════════════════════════════════════════════════ -->

	<!-- iOS 13+: descripción que ve el usuario al pedir permiso BLE -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>RIDERA usa Bluetooth para conectarte con tu convoy en tiempo real, incluso sin señal celular.</string>

	<!-- iOS 12 y anterior (legacy) -->
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>RIDERA usa Bluetooth para conectarte con tu convoy.</string>

	<!-- Ubicación (requerida para BLE scanning en iOS) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RIDERA necesita tu ubicación para mostrar tu posición en el mapa y compartirla con tu convoy.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>RIDERA necesita tu ubicación en segundo plano para seguir compartiendo tu posición con el convoy durante la rodada.</string>

	<!-- Cámara (para fotos de la rodada) -->
	<key>NSCameraUsageDescription</key>
	<string>RIDERA usa la cámara para tomar fotos durante la rodada.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>RIDERA guarda las fotos de la rodada en tu galería.</string>

	<!-- Background modes: BLE + Location -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>location</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
